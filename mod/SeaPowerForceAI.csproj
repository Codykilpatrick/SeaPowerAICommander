<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SeaPowerForceAI</AssemblyName>
    <RootNamespace>SeaPowerForceAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>

    <!-- Unity Mono loads a bare DLL; no deps.json, no satellite assemblies. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>

    <!-- The game assemblies are decompiled/obfuscation-free but not XML-documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />

    <!-- Shared with the sidecar. Unlike the game references below, this one IS copied
         next to the plugin - the game process has no other source for it. -->
    <ProjectReference Include="..\contract\SeaPowerForceAI.Contract.csproj" />
  </ItemGroup>

  <!--
    Every reference below is Private=false: these assemblies already exist in the
    game process. Copying them next to the plugin would load duplicates and break
    type identity (a Taskforce from our copy != the game's Taskforce).
  -->
  <ItemGroup>
    <Reference Include="Seapower-Scripts">
      <HintPath>$(GameManagedDir)\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assets">
      <HintPath>$(GameManagedDir)\Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Libraries">
      <HintPath>$(GameManagedDir)\Libraries.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(GameManagedDir)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The game already ships Newtonsoft.Json. Using it avoids pulling
         System.Text.Json and its BCL dependency tree into Unity's Mono runtime. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(GameManagedDir)\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameManagedDir)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(GameManagedDir)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDir)\AnchorChain.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Deploy straight into BepInEx/plugins so a rebuild is ready on next game launch.
    Sea Power cannot hot-reload code mods - you must fully restart the game.
    Skip with: dotnet build -p:DeployToGame=false
  -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(DeployToGame)' != 'false' AND Exists('$(StreamingAssetsDir)')">
    <ItemGroup>
      <!-- The plugin, the contract assembly it depends on, and the manifest that makes
           the folder show up as a mod in the in-game menu. -->
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="$(TargetDir)SeaPowerForceAI.Contract.dll" />
      <DeployFiles Include="$(MSBuildProjectDirectory)\..\_info.ini" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(ModDeployDir)" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed to $(ModDeployDir)" />
  </Target>

</Project>
